---
import type { CollectionEntry } from "astro:content";

interface Props {
  categories: CollectionEntry<"categories">[];
  current?: { category: string; doc: string };
}
const { categories, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function docSlug(doc: { source: string; slug?: string }) {
  return doc.slug ?? doc.source.replace(/\.typ$/, "");
}

const totalDocs = categories.reduce((sum, c) => sum + c.data.docs.length, 0);
---

<aside class="sidebar">
  <nav class="groups">
    {
      categories.map((cat) => (
        <div class="group">
          <div class="group-label">
            <span>{cat.data.title}</span>
            <span class="group-count">{cat.data.docs.length}</span>
          </div>
          <ul>
            {[...cat.data.docs]
              .map((doc) => {
                const slug = docSlug(doc);
                const active = current?.category === cat.id && current?.doc === slug;
                return (
                  <li>
                    <a href={`${base}/${cat.id}/${slug}/`} class:list={["entry", { active }]}>
                      <span class="entry-title">{doc.title}</span>
                    </a>
                  </li>
                );
              })}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>

<style>
  .sidebar {
    width: 280px;
    flex-shrink: 0;
    border-right: 1px solid var(--line);
    background: var(--paper-raised);
    height: 100%;
    max-height: 100%;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
  }
  .sidebar-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.1rem 1.25rem 0.7rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
  }
  .groups {
    padding-bottom: 1.5rem;
  }
  .group {
    padding: 0.6rem 1.25rem;
  }
  .group-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0.4rem;
  }
  .group-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-soft);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .entry {
    display: block;
    text-decoration: none;
    padding: 0.4rem 0.5rem;
    border-radius: 5px;
    font-size: 0.88rem;
    color: var(--ink-soft);
    border-left: 2px solid transparent;
    transition:
      background 0.12s ease,
      color 0.12s ease;
  }
  .entry:hover {
    background: var(--accent-soft);
    color: var(--ink);
  }
  .entry.active {
    color: var(--accent);
    border-left-color: var(--accent);
    background: var(--accent-soft);
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .sidebar {
      width: 100%;
      height: auto;
      max-height: 40vh;
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
